# Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://visiontrack:visiontrack@localhost:5432/visiontrack
DATABASE_URL_SYNC=postgresql://visiontrack:visiontrack@localhost:5432/visiontrack

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Vision
YOLO_MODEL=yolov8n.pt
YOLO_PLATE_MODEL=yolov8n.pt
OCR_ENGINE=easyocr
DEVICE=auto

# Processing
FRAME_SKIP=2
CONFIDENCE_THRESHOLD=0.5
DUPLICATE_SUPPRESSION_SECONDS=300

# AI Assistant (optional)
LLM_API_KEY=
LLM_MODEL=gemini-pro

# Logging
LOG_LEVEL=INFO

# App
APP_ENV=development
DEMO_MODE=true
